# Supabase Project Settings → API. Leave blank until a project is provisioned.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Required for the protected CSV import action; never expose as NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=

# One-time bootstrap script only; provide an existing Auth user UUID at execution time.
BOOTSTRAP_OWNER_USER_ID=
BOOTSTRAP_ORGANIZATION_NAME=

# Generate independent 32-byte values, base64 encoded. Server only.
CARD_ENCRYPTION_KEY=
CARD_FINGERPRINT_KEY=

# No real credentials belong in this example file.
